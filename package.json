{
  "name": "bassthermal",
  "private": true,
  "scripts": {
    "deploy": "npm run build:site && wrangler deploy",
    "dev": "npm run build:site && wrangler dev",
    "assets:validate": "node tools/validate-asset-layout.mjs",
    "assets:index": "npm run assets:validate && node tools/build-asset-manifest.mjs && node tools/append-app-icon-runtime.mjs",
    "catalog:build": "node tools/build-catalog.mjs",
    "catalog:validate": "node tools/build-catalog.mjs --validate-only",
    "home:build": "node tools/build-homepage-chrome.mjs",
    "home:validate": "node tools/build-homepage-chrome.mjs --validate-only",
    "publisher:build": "node tools/build-publisher-surfaces.mjs",
    "publisher:validate": "node tools/build-publisher-surfaces.mjs --validate-only",
    "build:site": "npm run assets:index && npm run catalog:build && npm run home:build && npm run publisher:build && npm run bt-tools-feed:build",
    "bt-tools-feed:build": "node tools/build-bt-tools-feed.mjs",
    "test:redirects": "node tools/test-redirects.mjs",
    "test:product-pages": "node tools/validate-product-pages.mjs",
    "test:site-composition": "npm run home:validate && node tools/test-site-composition.mjs",
    "test:guide-content": "node tools/test-guide-content.mjs",
    "test:publisher": "npm run publisher:validate",
    "test:all": "npm run test:redirects && npm run test:product-pages && npm run test:site-composition && npm run test:guide-content && npm run test:publisher && npm run test:terminal-visits && npm run test:app-icons",
    "test:terminal-visits": "node tools/test-terminal-visits.mjs",
    "test:app-icons": "npm run assets:index && node tools/test-app-icons.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.16.0"
  }
}
